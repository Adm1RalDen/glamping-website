# Environment Variables Example
# Copy this file to .env.local for local development

# API endpoints (if needed in the future)
# REACT_APP_API_URL=https://api.example.com

# Google Analytics (if needed)
# REACT_APP_GA_TRACKING_ID=UA-XXXXXXXXX-X

# Contact form endpoint (if using a service like Formspree)
# REACT_APP_CONTACT_FORM_URL=https://formspree.io/f/your-form-id

# Site metadata
REACT_APP_SITE_NAME=Hidden Heaven Glamping
REACT_APP_CONTACT_EMAIL=hidden.heaven@email.com
REACT_APP_CONTACT_PHONE=+1 (234) 567 89 00
